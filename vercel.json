{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/site/index.html" },
    { "source": "/index.html", "destination": "/site/index.html" },
    { "source": "/((?!api/).*)", "destination": "/site/$1" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
